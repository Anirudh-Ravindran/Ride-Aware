    "\"blink\":%s,\"brake\":%s,\"imuOK\":%s,\"distanceFt\":%s,"
    "\"distanceFresh\":%s,\"rxAgeMs\":%s,\"uptimeMs\":%lu}",
    radioReady?"true":"false",linked?"true":"false",requestedTurn,linked?rear.turn:0,
    linked&&rear.blink?"true":"false",linked&&rear.brake?"true":"false",
    linked&&rear.imuOK?"true":"false",distance,fresh?"true":"false",rxAge,(unsigned long)now);
  server.sendHeader("Cache-Control","no-store");
  server.sendHeader("Connection","close");
  server.send(200,"application/json",json);
}
void redirectToPortal() {
  server.sendHeader("Cache-Control","no-store");
  server.sendHeader("Location","http://192.168.4.1/",true);
  server.sendHeader("Connection","close");
  server.send(302,"text/plain","Open Ride-Aware at http://192.168.4.1/");
}
void startPhoneServer() {
  server.on("/",HTTP_GET,[](){
    server.sendHeader("Cache-Control","no-store");
    server.send_P(200,"text/html; charset=utf-8",PHONE_PAGE);
  });
  server.on("/api/status",HTTP_GET,servePhoneStatus);
  // Answer connectivity probes with the portal instead of an internet-success page.
  const char* probes[]={"/hotspot-detect.html","/library/test/success.html",
    "/generate_204","/gen_204","/connecttest.txt","/ncsi.txt","/redirect"};
  for (const char* path:probes) server.on(path,HTTP_GET,redirectToPortal);
  server.onNotFound(redirectToPortal);
  bool dnsReady=dnsServer.start(53,"*",IPAddress(192,168,4,1));
  Serial.println(dnsReady?"Captive portal DNS ready":"Captive DNS failed: use numeric IP in Safari");
  server.begin();
  Serial.println("PHONE: join RideAware / password rideaware123");
  Serial.println("PHONE: open http://192.168.4.1 and tap Enable sound");
}

void setup() {
  Serial.begin(115200); delay(1500);
  Serial.printf("FRONT v13: INDEPENDENT HEARTBEAT / 3 FT / MAX BEEP AT 0.5 FT. Reset reason: %d\n",static_cast<int>(esp_reset_reason()));
  pinMode(LEFT_BUTTON,INPUT_PULLUP); pinMode(RIGHT_BUTTON,INPUT_PULLUP);
  pinMode(LEFT_LED,OUTPUT); pinMode(RIGHT_LED,OUTPUT);
  digitalWrite(LEFT_LED,LOW); digitalWrite(RIGHT_LED,LOW);
  Wire.begin(OLED_SDA,OLED_SCL); Wire.setClock(100000); Wire.setTimeOut(20);
  uint8_t address=0;
  for (uint8_t candidate=0x3C;candidate<=0x3D;candidate++) {
    Wire.beginTransmission(candidate);
    if (Wire.endTransmission()==0) { address=candidate; break; }
  }
  if (address) displayReady=display.begin(SSD1306_SWITCHCAPVCC,address,false,false);
  Serial.println(displayReady?"OLED ready":"OLED missing: buttons/radio still run");
  radioReady=startRadio();
  Serial.println(radioReady?"FRONT: ESP-NOW ready, channel 1":"RADIO FAILED: press RESET");
  if (radioReady) {
    heartbeatReady=xTaskCreate(commandHeartbeat,"RideHeartbeat",4096,nullptr,1,nullptr)==pdPASS;
    Serial.println(heartbeatReady?"Independent radio heartbeat ready":"Heartbeat task failed: using loop fallback");
  }
  startPhoneServer();
  drawScreen(false);
}
void loop() {
  uint32_t now=millis(), packetTime=0;
  Packet incoming;
  if (takePacket(incoming,packetTime)) {
    rear=incoming; lastRearAt=packetTime; rearSeen=true;
    // Carry a valid held value across missing echoes or a rear restart.
    if (rear.distanceCm>=2.0f) { lastDistanceCm=rear.distanceCm; hasDistance=true; }
  }
  now=millis(); // Sample AFTER taking the packet; prevent unsigned timestamp underflow.
  uint32_t rxAge=rearSeen?now-lastRearAt:0;
  bool linked=radioReady && rearSeen && rxAge<LINK_TIMEOUT_MS;
  static uint32_t previousLoopAt=0;
  if (previousLoopAt && now-previousLoopAt>=500) {
    Serial.printf("LOOP GAP: %lu ms | Heartbeat:%s\n",(unsigned long)(now-previousLoopAt),heartbeatReady?"TASK":"LOOP FALLBACK");
  }
  previousLoopAt=now;
  static bool previousLink=false;
  if (linked!=previousLink) {
    Serial.printf("LINK %s | RX age:%lu ms | Uptime:%lu s\n",linked?"ON":"OFF",(unsigned long)rxAge,(unsigned long)(now/1000));
    previousLink=linked;
  }
  if (pressed(leftButton,now)) requestedTurn=requestedTurn==1?0:1;
  if (pressed(rightButton,now)) requestedTurn=requestedTurn==2?0:2;
  portENTER_CRITICAL(&commandLock);
  heartbeatTurn=requestedTurn;
  portEXIT_CRITICAL(&commandLock);
  // Front LEDs show the turn actually acknowledged by the rear.
  uint8_t actualTurn=linked?rear.turn:0;
  bool flash=linked && rear.blink; // Follow the rear phase, not an independent clock.
  digitalWrite(LEFT_LED,actualTurn==1 && flash);
  digitalWrite(RIGHT_LED,actualTurn==2 && flash);
  if (!heartbeatReady && now-lastSend>=110) {
    lastSend=now;
    Packet p={}; p.source=1; p.turn=requestedTurn; sendPacket(p);
  }
  // Redraw immediately when the same phase used by the front LEDs changes.
  // The 200 ms refresh is only a fallback for distance updates.
  static bool drawnLinked=false, drawnFlash=false;
  static uint8_t drawnTurn=0;
  if (linked!=drawnLinked || flash!=drawnFlash || actualTurn!=drawnTurn || now-lastDisplay>=200) {
    lastDisplay=now;
    drawScreen(linked);
    drawnLinked=linked; drawnFlash=flash; drawnTurn=actualTurn;
  }
  if (now-lastLog>=500) {
    lastLog=now;
    Serial.printf("Uptime:%lu s RX age:%lu ms Rear:%s Requested turn:%u Actual turn:%u Brake:%s | ",
      (unsigned long)(millis()/1000),(unsigned long)(rearSeen?millis()-lastRearAt:0),
      linked?"LINKED":"OFFLINE",requestedTurn,actualTurn,!linked?"UNKNOWN":rear.brake?"ON":"OFF");
    if (hasDistance) Serial.printf("%.2f ft [%s]\n",lastDistanceCm/30.48f,
      linked && rear.distanceOK?"LIVE":"LAST KNOWN");
    else Serial.println("Distance: waiting for first echo");
  }
  dnsServer.processNextRequest();
  server.handleClient();
  delay(1);
}
