bool displayReady=false, rearSeen=false, hasDistance=false;
uint8_t requestedTurn=0;
portMUX_TYPE commandLock = portMUX_INITIALIZER_UNLOCKED;
uint8_t heartbeatTurn=0;
bool heartbeatReady=false;
uint32_t lastRearAt=0, lastSend=0, lastDisplay=0, lastLog=0;
float lastDistanceCm=0;
Packet rear={};

// Only this task sends commands when task creation succeeds.
// Phone requests and OLED transfers run in loop(), independently.
void commandHeartbeat(void*) {
  for (;;) {
    Packet p={};
    p.source=1;
    portENTER_CRITICAL(&commandLock);
    p.turn=heartbeatTurn;
    portEXIT_CRITICAL(&commandLock);
    sendPacket(p);
    vTaskDelay(pdMS_TO_TICKS(110));
  }
}
struct Button {
  int pin;
  bool raw=HIGH, stable=HIGH;
  uint32_t changedAt=0;
};
Button leftButton={LEFT_BUTTON}, rightButton={RIGHT_BUTTON};
// Explicit declaration avoids Arduino-generated prototypes before custom types.
bool pressed(Button &button, uint32_t now);
bool pressed(Button &button, uint32_t now) {
  bool value=digitalRead(button.pin);
  if (value!=button.raw) { button.raw=value; button.changedAt=now; }
  if (value!=button.stable && now-button.changedAt>=35) {
    button.stable=value;
    return value==LOW;
  }
  return false;
}
void drawScreen(bool linked) {
  if (!displayReady) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0,0);
  display.print("Ride-Aware");
  if (linked) display.fillCircle(94,4,3,SSD1306_WHITE);
  else display.drawCircle(94,4,3,SSD1306_WHITE);
  display.setCursor(102,0);
  display.print(linked?"LINK":"OFF");
  display.drawLine(0,12,127,12,SSD1306_WHITE);

  // Direction arrow flashes with the rear's acknowledged turn.
  if (linked && rear.blink) {
    if (rear.turn==1) {
      display.fillRect(25,26,31,10,SSD1306_WHITE);
      display.fillTriangle(26,18,26,44,7,31,SSD1306_WHITE);
    } else if (rear.turn==2) {
      display.fillRect(72,26,31,10,SSD1306_WHITE);
      display.fillTriangle(101,18,101,44,120,31,SSD1306_WHITE);
    }
  }
  char feet[20];
  if (hasDistance) snprintf(feet,sizeof(feet),"%.1f ft",lastDistanceCm/30.48f);
  else snprintf(feet,sizeof(feet),"-- ft");
  int x=(128-static_cast<int>(strlen(feet))*12)/2;
  display.setTextSize(2);
  display.setCursor(x<0?0:x,48);
  display.print(feet);
  display.display();
}

