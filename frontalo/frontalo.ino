constexpr uint8_t BROADCAST[] = {255,255,255,255,255,255};
// Keep this packet identical in BOTH sketches. Distances travel in cm;
// user-facing output converts to feet. distanceOK describes freshness.
struct __attribute__((packed)) Packet {
  uint32_t magic, sequence;
  uint8_t source, turn, brake, distanceOK, imuOK, blink;
  float distanceCm, forwardAccel;
};
static_assert(sizeof(Packet) == 22, "Packet layout changed");
bool takePacket(Packet &p, uint32_t &time);
void sendPacket(Packet &p);
portMUX_TYPE mailboxLock = portMUX_INITIALIZER_UNLOCKED;
Packet mailbox = {};
bool pendingPacket = false;
uint32_t receivedAt = 0;
bool radioReady = false;
uint32_t sequence = 0;

void onReceive(const esp_now_recv_info_t*, const uint8_t* data, int len) {
  if (len != sizeof(Packet)) return;
  Packet p;
  memcpy(&p, data, sizeof(p));
  if (p.magic != MAGIC || p.source != OTHER_NODE || p.turn > 2 ||
      p.brake > 1 || p.distanceOK > 1 || p.imuOK > 1 || p.blink > 1 ||
      !isfinite(p.distanceCm) || p.distanceCm < 0 || p.distanceCm > 400 ||
      !isfinite(p.forwardAccel)) return;
  portENTER_CRITICAL(&mailboxLock);
  mailbox = p;
  receivedAt = millis();
  pendingPacket = true;
  portEXIT_CRITICAL(&mailboxLock);
}
bool takePacket(Packet &p, uint32_t &time) {
  portENTER_CRITICAL(&mailboxLock);
  bool ready = pendingPacket;
  if (ready) { p = mailbox; time = receivedAt; pendingPacket = false; }
  portEXIT_CRITICAL(&mailboxLock);
  return ready;
}
bool startRadio() {
  // Keep the phone AP and ESP-NOW station interface on channel 1.
  // Do not call WiFi.begin() to join a separate router.
  WiFi.mode(WIFI_AP_STA);
  WiFi.setSleep(false);
  if (!WiFi.softAPConfig(IPAddress(192,168,4,1),IPAddress(192,168,4,1),IPAddress(255,255,255,0))) return false;
  if (!WiFi.softAP(PHONE_SSID, PHONE_PASSWORD, CHANNEL, 0, 2)) return false;
  if (esp_wifi_set_channel(CHANNEL, WIFI_SECOND_CHAN_NONE) != ESP_OK) return false;
  if (esp_now_init() != ESP_OK) return false;
  if (esp_now_register_recv_cb(onReceive) != ESP_OK) return false;
  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, BROADCAST, 6);
  peer.channel = CHANNEL;
  peer.ifidx = WIFI_IF_STA;
  peer.encrypt = false;
  return esp_now_add_peer(&peer) == ESP_OK;
}
void sendPacket(Packet &p) {
  if (!radioReady) return;
  p.magic = MAGIC;
  p.sequence = sequence++;
  if (esp_now_send(BROADCAST, reinterpret_cast<const uint8_t*>(&p), sizeof(p)) != ESP_OK)
    Serial.println("Radio: could not queue packet");
}

